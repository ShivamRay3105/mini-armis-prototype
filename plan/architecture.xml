<mxfile host="app.diagrams.net">
  <diagram name="OT Security – Detailed Flow">
    <mxGraphModel dx="1600" dy="1200" grid="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- UI -->
        <mxCell id="ui" value="React Dashboard" style="rounded=1;fillColor=#dae8fc" vertex="1" parent="1">
          <mxGeometry x="650" y="20" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gateway" value="API Gateway" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Services -->
        <mxCell id="auth" value="Auth Service" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="event" value="Event Ingestion Service" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="650" y="230" width="260" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="asset" value="Asset Service" style="rounded=1;fillColor=#d5e8d4" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="risk" value="Risk Engine Service" style="rounded=1;fillColor=#e1d5e7" vertex="1" parent="1">
          <mxGeometry x="650" y="360" width="260" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="alert" value="Alert Service" style="rounded=1;fillColor=#f8cecc" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="Kafka (Event Bus)" style="rounded=1;fillColor=#fff2cc" vertex="1" parent="1">
          <mxGeometry x="1050" y="360" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" value="JWT / API Calls" edge="1" parent="1" source="ui" target="gateway">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="Auth Request" edge="1" parent="1" source="gateway" target="auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="Device Event JSON" edge="1" parent="1" source="gateway" target="event">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="Register / Fetch Asset" edge="1" parent="1" source="event" target="asset">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" value="Publish asset-events" edge="1" parent="1" source="event" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" value="Consume asset-events" edge="1" parent="1" source="kafka" target="risk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" value="Update Risk Score" edge="1" parent="1" source="risk" target="asset">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" value="Publish risk-events" edge="1" parent="1" source="risk" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e9" value="Consume risk-events" edge="1" parent="1" source="kafka" target="alert">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e10" value="WebSocket Alert" edge="1" parent="1" source="alert" target="ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
